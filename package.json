{
  "name": "scriptglass",
  "productName": "ScriptGlass",
  "version": "1.0.0",
  "description": "A minimalist, Git-powered screenwriting application using the Fountain format.",
  "author": "ScriptGlass Team",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:electron": "cross-env VITE_PLATFORM=electron vite build && node scripts/build-electron.js && shx cp preload.cjs dist/",
    "dist": "npm run build:electron && electron-builder",
    "preview": "vite preview",
    "clean": "rm -rf dist dist_electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.50.1",
    "axios": "^1.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "fountain-js": "^1.2.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.2.0",
    "simple-git": "^3.36.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.davitmargaryan.scriptglass",
    "productName": "ScriptGlass",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "preload.cjs",
      "package.json",
      "!node_modules"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/electron-icons/windows/icon.ico",
      "artifactName": "ScriptGlass-Setup.exe"
    },
    "mac": {
      "icon": "public/electron-icons/macos/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "asar": true
  }
}
